<Window x:Class="RestauranteGestor.Native.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RestauranteGestor.Native.Views"
        Title="RestoOS - Modular Core" Height="900" Width="1440"
        WindowState="Maximized" Background="{StaticResource Surface}" Foreground="{StaticResource OnSurface}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="272" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{StaticResource SurfaceLowest}">
      <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="◉  RestoOS" Foreground="{StaticResource Primary}" FontSize="18" FontWeight="Bold" Margin="8,12,8,4" />
          <TextBlock Text="Modular Core" Foreground="{StaticResource OnSurfaceVariant}" FontSize="12" Margin="8,0,8,16" />
          <Border Background="{StaticResource Tertiary}" CornerRadius="6" Padding="8" Margin="0,0,0,12">
            <TextBlock Text="●  Operando local" Foreground="#003824" FontWeight="Bold" HorizontalAlignment="Center" />
          </Border>
          <Border Background="{StaticResource SurfaceContainer}" CornerRadius="10" Padding="12" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="SUCURSAL ACTIVA" Foreground="{StaticResource Secondary}" FontWeight="Bold" FontSize="11" />
              <TextBlock Text="La Brasserie Urbana" Margin="0,5,0,0" />
              <TextBlock Text="Sucursal Centro" Foreground="{StaticResource OnSurfaceVariant}" FontSize="12" Margin="0,3,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom">
          <Button x:Name="BtnConfig" Content="⚙  Configuración  ›  Módulos" Style="{StaticResource NavButton}" Click="BtnModulos_Click" />
          <TextBlock Text="▦  Datos locales" Foreground="{StaticResource Tertiary}" FontSize="11" Margin="14,14,8,8" />
        </StackPanel>

        <StackPanel>
          <StackPanel x:Name="OperacionPanel">
            <TextBlock Text="OPERACIÓN" Foreground="{StaticResource Secondary}" FontSize="10" FontWeight="Bold" Margin="8,8,8,6" Opacity="0.9"/>
            <Button x:Name="BtnPos" Content="▭  Punto de Venta POS   F1" Style="{StaticResource NavButton}" Click="BtnPos_Click" />
            <Button x:Name="BtnMesas" Content="▦  Mesas y Salón   F2" Style="{StaticResource NavButton}" Click="BtnMesas_Click" />
            <Button x:Name="BtnKds" Content="♨  Cocina KDS   F3" Style="{StaticResource NavButton}" Click="BtnKds_Click" />
            <Button x:Name="BtnInventario" Content="▤  Inventario" Style="{StaticResource NavButton}" Click="BtnInventario_Click" />
            <Button x:Name="BtnReservas" Content="◰  Reservas" Style="{StaticResource NavButton}" Click="BtnReservas_Click" />
            <Button x:Name="BtnDelivery" Content="◎  Delivery" Style="{StaticResource NavButton}" Click="BtnDelivery_Click" />
            <Button x:Name="BtnMenu" Content="▭  Menú Digital" Style="{StaticResource NavButton}" Click="BtnMenu_Click" />
          </StackPanel>
          <StackPanel x:Name="AdminPanel" Margin="0,14,0,0">
            <Border Height="1" Background="{StaticResource Outline}" Opacity="0.4" Margin="8,0,8,10"/>
            <TextBlock Text="ADMINISTRACIÓN" Foreground="{StaticResource Secondary}" FontSize="10" FontWeight="Bold" Margin="8,0,8,6" Opacity="0.9"/>
            <Button x:Name="BtnModulos" Content="☷  Selector de Módulos" Style="{StaticResource NavButton}" Click="BtnModulos_Click" />
            <Button x:Name="BtnReportes" Content="▣  Reportes + Trazabilidad" Style="{StaticResource NavButton}" Click="BtnReportes_Click" />
            <Button x:Name="BtnConfiguracion" Content="Configuración del restaurante" Style="{StaticResource NavButton}" Click="BtnConfiguracion_Click" />
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="64" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Border Grid.Row="0" Background="{StaticResource SurfaceContainer}" BorderBrush="{StaticResource Outline}" BorderThickness="0,0,0,1">
        <Grid Margin="20,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Background="{StaticResource SurfaceHigh}" CornerRadius="8" Padding="12,7">
              <TextBlock x:Name="LblClock" Text="00:00:00" FontFamily="Consolas" FontWeight="Bold" />
            </Border>
            <TextBlock x:Name="LblRoute" Text="  Módulos" Foreground="{StaticResource OnSurfaceVariant}" VerticalAlignment="Center" FontSize="14" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Border Background="{StaticResource SurfaceHigh}" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
              <TextBlock x:Name="LblRole" Text="Dueño" Foreground="{StaticResource Secondary}" FontWeight="Bold" FontSize="11" />
            </Border>
            <TextBlock Text="RestoOS" Foreground="{StaticResource OnSurfaceVariant}" VerticalAlignment="Center" Margin="0,0,14,0" />
            <Border Background="{StaticResource Primary}" Width="32" Height="32" CornerRadius="16">
              <TextBlock Text="●" Foreground="#5D1800" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
            </Border>
            <Button Content="↻ Cambiar perfil" Style="{StaticResource SecondaryButton}" Height="32" Padding="10,0" FontSize="11" Margin="10,0,0,0" Click="BtnCambiarPerfil_Click" />
          </StackPanel>
        </Grid>
      </Border>
      <ContentControl x:Name="ContentHost" Grid.Row="1" />
    </Grid>
  </Grid>
</Window>
