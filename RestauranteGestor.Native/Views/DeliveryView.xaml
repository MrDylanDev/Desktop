<UserControl x:Class="RestauranteGestor.Native.Views.DeliveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Surface}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="Delivery" FontSize="28" FontWeight="Bold"/>
        <Border Background="{StaticResource SurfaceContainer}" CornerRadius="8" Padding="10,6" Margin="12,0,0,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="●" Foreground="{StaticResource Tertiary}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock Text="Agregador conectado (DEMO)" Foreground="{StaticResource OnSurfaceVariant}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        <Border Background="{StaticResource SurfaceContainer}" CornerRadius="8" Padding="8,4" Margin="8,0,0,0">
          <TextBlock Text="DEMO frontend" Foreground="{StaticResource Secondary}" FontSize="10" FontWeight="Bold"/>
        </Border>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button Content="+ Nuevo pedido" Style="{StaticResource PrimaryButton}" Height="36" Padding="12,0" Click="Nuevo_Click" Margin="0,0,8,0"/>
        <Button x:Name="BtnSincronizar" Content="↻  Sincronizar menú" Style="{StaticResource SecondaryButton}" Height="36" Padding="12,0" FontSize="12" Margin="0,0,12,0" Click="Sincronizar_Click"/>
        <ComboBox x:Name="PlataformaBox" Width="150" Height="36" SelectionChanged="Plataforma_Changed" Margin="0,0,8,0"/>
        <ComboBox x:Name="EstadoBox" Width="140" Height="36" SelectionChanged="Estado_Changed"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Margin="0,16,0,12">
      <TextBox x:Name="SearchBox" Height="36" Padding="10,8" TextChanged="Search_Changed"/>
      <TextBlock Text="Buscar pedido, cliente..." Foreground="{StaticResource OnSurfaceVariant}" Opacity="0.45" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </Grid>

    <Border Grid.Row="2" Background="{StaticResource SurfaceLowest}" CornerRadius="14" Padding="12">
      <ListView x:Name="PedidosList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto">
        <ListView.View>
          <GridView>
            <GridViewColumn Header="Hora" Width="60" DisplayMemberBinding="{Binding HoraText}"/>
            <GridViewColumn Header="Plataforma" Width="110">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <Border Background="{Binding PlataformaBg}" CornerRadius="6" Padding="6,3">
                    <TextBlock Text="{Binding Plataforma}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                  </Border>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="ID" Width="90" DisplayMemberBinding="{Binding Id}"/>
            <GridViewColumn Header="Cliente" Width="120" DisplayMemberBinding="{Binding Cliente}"/>
            <GridViewColumn Header="Detalle" Width="230">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Detalle}" TextWrapping="Wrap" FontSize="12" MaxWidth="212"/>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Total" Width="90">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding TotalText}" Foreground="{StaticResource Primary}" FontWeight="Bold"/>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Estado" Width="120">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <Border Background="{Binding EstadoBg}" CornerRadius="6" Padding="6,3">
                    <TextBlock Text="{Binding Estado}" Foreground="{Binding EstadoFg}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                  </Border>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Acciones" Width="248">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <Button Content="Editar" Style="{StaticResource SecondaryButton}" Height="26" Padding="8,0" FontSize="11" Margin="0,0,6,0" Click="Editar_Click" Tag="{Binding}"/>
                    <Button Content="×" Style="{StaticResource DangerButton}" Height="26" Width="26" FontSize="12" Margin="0,0,6,0" Click="Eliminar_Click" Tag="{Binding}"/>
                    <Button Height="26" Padding="8,0" FontSize="11" Click="Avanzar_Click" Tag="{Binding}">
                      <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                          <Setter Property="Content" Value="✓  Avanzar"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Estado}" Value="Nuevo">
                              <Setter Property="Content" Value="▶  En preparación"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Estado}" Value="En preparación">
                              <Setter Property="Content" Value="✓  Listo para rider"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Estado}" Value="Listo para rider">
                              <Setter Property="Content" Value="✓  Entregado"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Estado}" Value="Entregado">
                              <Setter Property="Content" Value="✓  Entregado"/>
                              <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Button.Style>
                    </Button>
                  </StackPanel>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
          </GridView>
        </ListView.View>
      </ListView>
    </Border>

    <Border Grid.Row="3" Background="{StaticResource SurfaceContainer}" CornerRadius="10" Padding="12" Margin="0,12,0,0">
      <TextBlock Text="* Integración vía agregador/middleware (md:52) simulada: Rappi/Uber Eats/DiDi Food llegan a la misma cola que salón. Sincronizar empuja precio/disponibilidad de Menú a plataformas." Foreground="{StaticResource OnSurfaceVariant}" FontSize="11" TextWrapping="Wrap"/>
    </Border>
  </Grid>
</UserControl>
