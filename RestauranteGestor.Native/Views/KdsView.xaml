<UserControl x:Class="RestauranteGestor.Native.Views.KdsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Surface}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,16">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="Cocina KDS" FontSize="28" FontWeight="Bold"/>
        <Border Background="{StaticResource SurfaceContainer}" CornerRadius="8" Padding="10,6" Margin="16,0,0,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="●" Foreground="{StaticResource Tertiary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock x:Name="PendingCount" Text="0 pendientes" Foreground="{StaticResource OnSurfaceVariant}" FontSize="12" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        <ComboBox x:Name="StationBox" Width="160" Height="36" Margin="16,0,0,0" SelectionChanged="StationBox_SelectionChanged"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Border Background="{StaticResource SurfaceContainer}" CornerRadius="8" Padding="10,6" Margin="0,0,8,0">
          <TextBlock x:Name="ClockText" Text="00:00:00" FontFamily="Consolas" FontWeight="Bold" FontSize="12"/>
        </Border>
        <TextBlock Text="DEMO frontend" Foreground="{StaticResource Secondary}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Opacity="0.7"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="280"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="*" MinWidth="280"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="*" MinWidth="280"/>
      </Grid.ColumnDefinitions>

      <!-- Nuevo -->
      <Border Grid.Column="0" Background="{StaticResource SurfaceLowest}" CornerRadius="14" Padding="12">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Border Background="#FFB95F" Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="Nuevo" FontWeight="Bold" FontSize="14"/>
            <Border Background="{StaticResource SurfaceHigh}" CornerRadius="10" Padding="6,2" Margin="8,0,0,0">
              <TextBlock x:Name="NuevoCount" Text="0" FontSize="11" FontWeight="Bold"/>
            </Border>
          </StackPanel>
          <ListBox x:Name="NuevoList" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Background="{StaticResource SurfaceContainer}" CornerRadius="12" Padding="12" Margin="0,0,0,10" BorderBrush="#FFB95F" BorderThickness="1">
                  <StackPanel>
                    <Grid>
                      <TextBlock Text="{Binding Mesa}" FontWeight="Bold" FontSize="15"/>
                      <TextBlock Text="{Binding Elapsed}" Foreground="{Binding ElapsedBrush}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{Binding CreatedText}" Foreground="{StaticResource OnSurfaceVariant}" FontSize="11" Margin="0,2,0,8"/>
                    <ItemsControl ItemsSource="{Binding Items}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Margin="0,0,0,6">
                            <TextBlock Text="{Binding Line}" FontSize="13" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Note}" Foreground="{StaticResource Secondary}" FontSize="11" FontStyle="Italic" TextWrapping="Wrap">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Style.Triggers>
                                    <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                                    <Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="▶  Preparar" Style="{StaticResource PrimaryButton}" Height="36" FontSize="12" Margin="0,8,0,0" Click="Preparar_Click" Tag="{Binding}"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

      <!-- En preparación -->
      <Border Grid.Column="2" Background="{StaticResource SurfaceLowest}" CornerRadius="14" Padding="12">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Border Background="{StaticResource Primary}" Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="En preparación" FontWeight="Bold" FontSize="14"/>
            <Border Background="{StaticResource SurfaceHigh}" CornerRadius="10" Padding="6,2" Margin="8,0,0,0">
              <TextBlock x:Name="PrepCount" Text="0" FontSize="11" FontWeight="Bold"/>
            </Border>
          </StackPanel>
          <ListBox x:Name="PrepList" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Background="{StaticResource SurfaceContainer}" CornerRadius="12" Padding="12" Margin="0,0,0,10" BorderBrush="{StaticResource Primary}" BorderThickness="1">
                  <StackPanel>
                    <Grid>
                      <TextBlock Text="{Binding Mesa}" FontWeight="Bold" FontSize="15"/>
                      <TextBlock Text="{Binding Elapsed}" Foreground="{Binding ElapsedBrush}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{Binding CreatedText}" Foreground="{StaticResource OnSurfaceVariant}" FontSize="11" Margin="0,2,0,8"/>
                    <ItemsControl ItemsSource="{Binding Items}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Margin="0,0,0,6">
                            <TextBlock Text="{Binding Line}" FontSize="13" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Note}" Foreground="{StaticResource Secondary}" FontSize="11" FontStyle="Italic" TextWrapping="Wrap">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Style.Triggers>
                                    <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                                    <Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="0,8,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <Button Grid.Column="0" Content="◀ Nuevo" Style="{StaticResource SecondaryButton}" Height="36" FontSize="11" Margin="0,0,6,0" Click="Devolver_Click" Tag="{Binding}"/>
                      <Button Grid.Column="1" Content="✓ Listo" Style="{StaticResource PrimaryButton}" Height="36" FontSize="11" Margin="6,0,0,0" Click="Listo_Click" Tag="{Binding}"/>
                    </Grid>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="3" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

      <!-- Listo -->
      <Border Grid.Column="4" Background="{StaticResource SurfaceLowest}" CornerRadius="14" Padding="12">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Border Background="{StaticResource Tertiary}" Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="Listo" FontWeight="Bold" FontSize="14"/>
            <Border Background="{StaticResource SurfaceHigh}" CornerRadius="10" Padding="6,2" Margin="8,0,0,0">
              <TextBlock x:Name="ListoCount" Text="0" FontSize="11" FontWeight="Bold"/>
            </Border>
          </StackPanel>
          <ListBox x:Name="ListoList" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Background="{StaticResource SurfaceContainer}" CornerRadius="12" Padding="12" Margin="0,0,0,10" BorderBrush="{StaticResource Tertiary}" BorderThickness="1" Opacity="0.95">
                  <StackPanel>
                    <Grid>
                      <TextBlock Text="{Binding Mesa}" FontWeight="Bold" FontSize="15"/>
                      <TextBlock Text="{Binding Elapsed}" Foreground="{StaticResource Tertiary}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{Binding CreatedText}" Foreground="{StaticResource OnSurfaceVariant}" FontSize="11" Margin="0,2,0,8"/>
                    <ItemsControl ItemsSource="{Binding Items}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Margin="0,0,0,6">
                            <TextBlock Text="{Binding Line}" FontSize="13" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Note}" Foreground="{StaticResource Secondary}" FontSize="11" FontStyle="Italic" TextWrapping="Wrap">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Style.Triggers>
                                    <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                                    <Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="0,8,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <Button Grid.Column="0" Content="↺ Preparación" Style="{StaticResource SecondaryButton}" Height="36" FontSize="10" Margin="0,0,6,0" Click="Reabrir_Click" Tag="{Binding}"/>
                      <Button Grid.Column="1" Content="✓ Entregado" Style="{StaticResource DangerButton}" Height="36" FontSize="11" Margin="6,0,0,0" Click="Entregado_Click" Tag="{Binding}"/>
                    </Grid>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
