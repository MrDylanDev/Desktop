<Window x:Class="RestauranteGestor.Native.Views.ReceiptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vista previa del recibo" Width="420" Height="620" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{StaticResource Surface}" Foreground="{StaticResource OnSurface}">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="White" Padding="18">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="ReceiptText" Foreground="Black" FontFamily="Consolas" FontSize="14" TextWrapping="Wrap" />
      </ScrollViewer>
    </Border>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="Cerrar" Style="{StaticResource SecondaryButton}" Width="100" Click="Close_Click" />
      <Button Content="Imprimir" Style="{StaticResource PrimaryButton}" Width="110" Margin="10,0,0,0" Click="Print_Click" />
    </StackPanel>
  </Grid>
</Window>
