<UserControl x:Class="RestauranteGestor.Native.Views.ReservasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Surface}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,16">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="Reservas" FontSize="28" FontWeight="Bold"/>
        <Border Background="{StaticResource SurfaceContainer}" CornerRadius="8" Padding="10,6" Margin="12,0,0,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="◰" Foreground="{StaticResource Secondary}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="FechaLabel" Text="Hoy" Foreground="{StaticResource OnSurfaceVariant}" FontSize="12" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        <Border Background="{StaticResource SurfaceContainer}" CornerRadius="8" Padding="8,4" Margin="8,0,0,0">
          <TextBlock Text="DEMO frontend" Foreground="{StaticResource Secondary}" FontSize="10" FontWeight="Bold"/>
        </Border>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button Content="+ Nueva reserva" Style="{StaticResource PrimaryButton}" Height="36" Padding="12,0" Click="Add_Click"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="340" MinWidth="300" MaxWidth="380"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="*" MinWidth="380"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource SurfaceLowest}" CornerRadius="14" Padding="12">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="Calendario" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
          <Calendar x:Name="Cal" Grid.Row="1" Background="{StaticResource SurfaceLowest}" Foreground="{StaticResource OnSurface}" BorderThickness="0" SelectedDatesChanged="Cal_SelectedDatesChanged"/>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

      <Border Grid.Column="2" Background="{StaticResource SurfaceLowest}" CornerRadius="14" Padding="12">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="0,0,8,0">
              <TextBox x:Name="SearchBox" Height="36" Padding="10,8" TextChanged="SearchBox_TextChanged"/>
              <TextBlock Text="Buscar cliente o mesa..." Foreground="{StaticResource OnSurfaceVariant}" Opacity="0.45" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
            <ComboBox x:Name="EstadoBox" Grid.Column="1" Height="36" SelectionChanged="EstadoBox_SelectionChanged"/>
          </Grid>

          <ListView x:Name="ReservaList" Grid.Row="1" Background="Transparent" BorderThickness="0">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Hora" Width="70" DisplayMemberBinding="{Binding HoraText}"/>
                <GridViewColumn Header="Cliente" Width="150" DisplayMemberBinding="{Binding Cliente}"/>
                <GridViewColumn Header="Pers." Width="55" DisplayMemberBinding="{Binding PersonasText}"/>
                <GridViewColumn Header="Mesa" Width="90" DisplayMemberBinding="{Binding Mesa}"/>
                <GridViewColumn Header="Estado" Width="110">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <Border Background="{Binding EstadoBg}" CornerRadius="6" Padding="6,3">
                        <TextBlock Text="{Binding Estado}" Foreground="{Binding EstadoFg}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                      </Border>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Tel." Width="110" DisplayMemberBinding="{Binding Telefono}"/>
                <GridViewColumn Header="Acciones" Width="150">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal">
                        <Button Content="Editar" Style="{StaticResource SecondaryButton}" Height="26" Padding="8,0" FontSize="11" Margin="0,0,6,0" Click="Edit_Click" Tag="{Binding}"/>
                        <Button Content="×" Style="{StaticResource DangerButton}" Height="26" Width="26" Click="Delete_Click" Tag="{Binding}"/>
                      </StackPanel>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
              </GridView>
            </ListView.View>
          </ListView>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="{StaticResource SurfaceContainer}" CornerRadius="10" Padding="12" Margin="0,12,0,0">
      <TextBlock Text="* Vista calendario/agenda con asignación de mesa (md:32-33) simulada. La persistencia y asignación real a salón quedan para Fase 2 con SQLite." Foreground="{StaticResource OnSurfaceVariant}" FontSize="11" TextWrapping="Wrap"/>
    </Border>
  </Grid>
</UserControl>
