<UserControl x:Class="RestauranteGestor.Native.Views.ConfiguracionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Surface}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28" MaxWidth="860" HorizontalAlignment="Left">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="Configuración" FontSize="32" FontWeight="Bold" />
        <Border Background="{StaticResource SurfaceContainer}" CornerRadius="8" Padding="8,4" Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Solo Admin" Foreground="{StaticResource Primary}" FontSize="10" FontWeight="Bold"/>
        </Border>
      </StackPanel>
      <TextBlock Text="Datos del negocio, impuesto por defecto y respaldos. Solo el Administrador." Foreground="{StaticResource OnSurfaceVariant}" Margin="0,8,0,0" TextWrapping="Wrap"/>

      <Border Style="{StaticResource Card}" Margin="0,20,0,0">
        <StackPanel>
          <TextBlock Text="Restaurante" FontSize="18" FontWeight="Bold" />
          <TextBlock Text="Nombre *" Foreground="{StaticResource OnSurfaceVariant}" FontSize="11" Margin="0,14,0,4"/>
          <TextBox x:Name="NameBox" Height="46" Padding="12,10,12,8" FontSize="15" FontWeight="SemiBold" TextOptions.TextFormattingMode="Display"/>
          <TextBlock Text="Dirección" Foreground="{StaticResource OnSurfaceVariant}" FontSize="11" Margin="0,12,0,4"/>
          <TextBox x:Name="AddressBox" Height="46" Padding="12,10,12,8" FontSize="15" FontWeight="SemiBold" TextOptions.TextFormattingMode="Display"/>
          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Teléfono" Foreground="{StaticResource OnSurfaceVariant}" FontSize="11" Margin="0,0,0,4"/>
              <TextBox x:Name="PhoneBox" Height="46" Padding="12,10,12,8" FontSize="15" FontWeight="SemiBold" TextOptions.TextFormattingMode="Display"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Moneda" Foreground="{StaticResource OnSurfaceVariant}" FontSize="11" Margin="0,0,0,4"/>
              <TextBox x:Name="CurrencyBox" Height="46" Padding="12,10,12,8" FontSize="15" FontWeight="SemiBold" TextOptions.TextFormattingMode="Display"/>
            </StackPanel>
          </Grid>
          <TextBlock Text="Logo (ruta de imagen)" Foreground="{StaticResource OnSurfaceVariant}" FontSize="11" Margin="0,12,0,4"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
            <TextBox x:Name="LogoBox" Grid.Column="0" Height="46" Padding="12,10,12,8" FontSize="15" FontWeight="SemiBold" TextOptions.TextFormattingMode="Display"/>
            <Button Grid.Column="2" Content="Examinar" Style="{StaticResource SecondaryButton}" Height="46" Click="BrowseLogo_Click"/>
          </Grid>
          <Button Content="Guardar datos" Style="{StaticResource PrimaryButton}" Height="44" Margin="0,18,0,0" Click="SaveRestaurant_Click"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Text="Impuesto por defecto" FontSize="18" FontWeight="Bold" />
          <TextBlock Text="El POS lo usa al abrir; se puede cambiar por venta." Foreground="{StaticResource OnSurfaceVariant}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
          <ComboBox x:Name="TaxBox" Height="46" FontSize="15" FontWeight="SemiBold" TextOptions.TextFormattingMode="Display" Margin="0,14,0,0" SelectionChanged="TaxBox_SelectionChanged"/>
          <Button Content="Guardar impuesto" Style="{StaticResource PrimaryButton}" Height="44" Margin="0,18,0,0" Click="SaveTax_Click"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Text="Respaldo" FontSize="18" FontWeight="Bold" />
          <TextBlock Text="Copia carta, pedidos, ajustes, mesas, módulos e impuesto con fecha y hora." Foreground="{StaticResource OnSurfaceVariant}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
          <TextBlock x:Name="BackupInfo" Text="Sin respaldos aún." Foreground="{StaticResource Secondary}" FontSize="12" FontWeight="Bold" Margin="0,14,0,0" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <Button Content="Crear respaldo ahora" Style="{StaticResource PrimaryButton}" Height="44" Padding="16,0" Click="Backup_Click"/>
            <Button Content="Abrir carpeta" Style="{StaticResource SecondaryButton}" Height="44" Padding="16,0" Margin="8,0,0,0" Click="OpenBackupFolder_Click"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Text="Datos" FontSize="18" FontWeight="Bold" />
          <TextBlock Text="Ubicación y tamaño de cada archivo. Útil para soporte." Foreground="{StaticResource OnSurfaceVariant}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
          <TextBlock x:Name="DataInfo" Foreground="{StaticResource OnSurfaceVariant}" FontSize="12" Margin="0,14,0,0" TextWrapping="Wrap"/>
          <Button Content="Actualizar" Style="{StaticResource SecondaryButton}" Height="40" Padding="14,0" Margin="0,14,0,0" HorizontalAlignment="Left" Click="Refresh_Click"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
