<Window x:Class="RestauranteGestor.Native.Views.TableDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar mesa" Width="420" Height="390" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{StaticResource Surface}" Foreground="{StaticResource OnSurface}">
  <StackPanel Margin="22">
    <TextBlock x:Name="TitleText" Text="Nueva mesa" FontSize="24" FontWeight="Bold" />
    <TextBlock Text="Nombre" Foreground="{StaticResource OnSurfaceVariant}" Margin="0,20,0,5" />
    <TextBox x:Name="NameBox" Height="38" Padding="8" Background="{StaticResource SurfaceHigh}" Foreground="{StaticResource OnSurface}" BorderThickness="0" />
    <TextBlock Text="Salón" Foreground="{StaticResource OnSurfaceVariant}" Margin="0,14,0,5" />
    <ComboBox x:Name="SectorBox" Height="36" Background="{StaticResource SurfaceHigh}" Foreground="{StaticResource OnSurface}" BorderThickness="0" />
    <TextBlock Text="Capacidad" Foreground="{StaticResource OnSurfaceVariant}" Margin="0,14,0,5" />
    <TextBox x:Name="CapacityBox" Height="38" Padding="8" Background="{StaticResource SurfaceHigh}" Foreground="{StaticResource OnSurface}" BorderThickness="0" />
    <TextBlock Text="Estado inicial" Foreground="{StaticResource OnSurfaceVariant}" Margin="0,14,0,5" />
    <ComboBox x:Name="StatusBox" Height="36" Background="{StaticResource SurfaceHigh}" Foreground="{StaticResource OnSurface}" BorderThickness="0" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
      <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Width="100" Click="Cancel_Click" />
      <Button Content="Guardar" Style="{StaticResource PrimaryButton}" Width="110" Margin="10,0,0,0" Click="Save_Click" />
    </StackPanel>
  </StackPanel>
</Window>
