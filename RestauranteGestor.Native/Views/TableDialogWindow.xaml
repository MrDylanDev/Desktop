<Window x:Class="RestauranteGestor.Native.Views.TableDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mesa" Width="460" Height="500" MinHeight="460" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{StaticResource Surface}" Foreground="{StaticResource OnSurface}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0">
    <Grid Margin="22">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="TitleText" Text="Nueva mesa" FontSize="24" FontWeight="Bold" Grid.Row="0" />
    <StackPanel Grid.Row="1" Margin="0,20,0,0">
      <TextBlock Text="Nombre *" Foreground="{StaticResource OnSurfaceVariant}" Margin="0,0,0,5" />
      <Grid>
        <TextBox x:Name="NameBox" Height="40" Padding="10,8" />
        <TextBlock Text="Ej: Mesa 12, Terraza 3..." Foreground="{StaticResource OnSurfaceVariant}" Opacity="0.45" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Text, ElementName=NameBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>
    </StackPanel>
    <StackPanel Grid.Row="2" Margin="0,14,0,0">
      <TextBlock Text="Salón" Foreground="{StaticResource OnSurfaceVariant}" Margin="0,0,0,5" />
      <ComboBox x:Name="SectorBox" Height="40" />
    </StackPanel>
    <StackPanel Grid.Row="3" Margin="0,14,0,0">
      <TextBlock Text="Capacidad" Foreground="{StaticResource OnSurfaceVariant}" Margin="0,0,0,5" />
      <ComboBox x:Name="CapacityBox" Height="40" IsEditable="True" Text="4 personas" IsTextSearchEnabled="False" />
    </StackPanel>
    <StackPanel Grid.Row="4" Margin="0,14,0,0">
      <TextBlock Text="Estado inicial" Foreground="{StaticResource OnSurfaceVariant}" Margin="0,0,0,5" />
      <ComboBox x:Name="StatusBox" Height="40" />
    </StackPanel>
      <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,28,0,6">
        <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Width="100" Height="40" Click="Cancel_Click" />
        <Button Content="Guardar" Style="{StaticResource PrimaryButton}" Width="110" Height="40" Margin="10,0,0,0" Click="Save_Click" />
      </StackPanel>
    </Grid>
  </ScrollViewer>
</Window>
