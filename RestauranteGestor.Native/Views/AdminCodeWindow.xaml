<Window x:Class="RestauranteGestor.Native.Views.AdminCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Código Administrador" Width="360" Height="520" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{StaticResource Surface}" Foreground="{StaticResource OnSurface}">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Text="Acceso Administrador" FontSize="20" FontWeight="Bold" Grid.Row="0" HorizontalAlignment="Center"/>
    <StackPanel Grid.Row="1" Margin="0,6,0,0" HorizontalAlignment="Center">
      <TextBlock Text="Código demo: 1234" Foreground="{StaticResource Primary}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center"/>
      <TextBlock Text="Expira 30/09/2026 · 4 dígitos numéricos" Foreground="{StaticResource OnSurfaceVariant}" FontSize="10" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,2,0,0"/>
    </StackPanel>

    <StackPanel Grid.Row="2" Margin="0,16,0,0" HorizontalAlignment="Center">
      <TextBlock Text="Ingresa el PIN" Foreground="{StaticResource OnSurfaceVariant}" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,8"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <Border Width="52" Height="52" CornerRadius="10" Background="{StaticResource SurfaceContainer}" BorderBrush="{StaticResource Outline}" BorderThickness="1" Margin="0,0,8,0">
          <TextBlock x:Name="D1" Text="" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <Border Width="52" Height="52" CornerRadius="10" Background="{StaticResource SurfaceContainer}" BorderBrush="{StaticResource Outline}" BorderThickness="1" Margin="0,0,8,0">
          <TextBlock x:Name="D2" Text="" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <Border Width="52" Height="52" CornerRadius="10" Background="{StaticResource SurfaceContainer}" BorderBrush="{StaticResource Outline}" BorderThickness="1" Margin="0,0,8,0">
          <TextBlock x:Name="D3" Text="" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <Border Width="52" Height="52" CornerRadius="10" Background="{StaticResource SurfaceContainer}" BorderBrush="{StaticResource Outline}" BorderThickness="1">
          <TextBlock x:Name="D4" Text="" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
      </StackPanel>
      <TextBlock x:Name="ErrorText" Text="Código incorrecto. Usa 1234." Foreground="{StaticResource Error}" FontSize="11" HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed"/>
    </StackPanel>

    <UniformGrid Grid.Row="3" Columns="3" Margin="0,20,0,0" VerticalAlignment="Top">
      <Button Content="1" Style="{StaticResource NumpadButton}" Click="Num_Click"/>
      <Button Content="2" Style="{StaticResource NumpadButton}" Click="Num_Click"/>
      <Button Content="3" Style="{StaticResource NumpadButton}" Click="Num_Click"/>
      <Button Content="4" Style="{StaticResource NumpadButton}" Click="Num_Click"/>
      <Button Content="5" Style="{StaticResource NumpadButton}" Click="Num_Click"/>
      <Button Content="6" Style="{StaticResource NumpadButton}" Click="Num_Click"/>
      <Button Content="7" Style="{StaticResource NumpadButton}" Click="Num_Click"/>
      <Button Content="8" Style="{StaticResource NumpadButton}" Click="Num_Click"/>
      <Button Content="9" Style="{StaticResource NumpadButton}" Click="Num_Click"/>
      <Button Content="C" Style="{StaticResource DangerButton}" Margin="4" MinHeight="52" FontSize="16" Click="Clear_Click"/>
      <Button Content="0" Style="{StaticResource NumpadButton}" Click="Num_Click"/>
      <Button Content="⌫" Style="{StaticResource SecondaryButton}" Margin="4" MinHeight="52" FontSize="16" Click="Back_Click"/>
    </UniformGrid>

    <Grid Grid.Row="4" Margin="0,16,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Button Grid.Column="0" Content="Cancelar" Style="{StaticResource SecondaryButton}" Height="44" Margin="0,0,6,0" Click="Cancel_Click"/>
      <Button Grid.Column="1" Content="Ingresar" Style="{StaticResource PrimaryButton}" Height="44" Margin="6,0,0,0" Click="Ok_Click"/>
    </Grid>
  </Grid>
</Window>
