<Window x:Class="RestauranteGestor.Native.Views.CheckoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cobrar venta" Width="500" Height="650" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{StaticResource Surface}" Foreground="{StaticResource OnSurface}">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0">
      <TextBlock Text="Cobro de venta" FontSize="26" FontWeight="Bold" />
      <TextBlock x:Name="MesaText" Text="Mesa no seleccionada" Foreground="{StaticResource Secondary}" Margin="0,6,0,0" />
    </StackPanel>
    <Border Grid.Row="1" Background="{StaticResource SurfaceContainer}" CornerRadius="12" Padding="16" Margin="0,20,0,14">
      <Grid><TextBlock Text="Total a cobrar" Foreground="{StaticResource OnSurfaceVariant}" /><TextBlock x:Name="TotalText" HorizontalAlignment="Right" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Primary}" /></Grid>
    </Border>
    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,14">
      <RadioButton x:Name="CashRadio" Content="Efectivo" IsChecked="True" Checked="PaymentMode_Changed" Margin="0,0,20,0" Foreground="{StaticResource OnSurface}" />
      <RadioButton x:Name="CardRadio" Content="Tarjeta" Checked="PaymentMode_Changed" Foreground="{StaticResource OnSurface}" />
    </StackPanel>
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
      <UniformGrid x:Name="Numpad" Grid.Column="0" Columns="3" Margin="0,0,14,0">
        <Button Content="7" Click="Numpad_Click" />
        <Button Content="8" Click="Numpad_Click" />
        <Button Content="9" Click="Numpad_Click" />
        <Button Content="4" Click="Numpad_Click" />
        <Button Content="5" Click="Numpad_Click" />
        <Button Content="6" Click="Numpad_Click" />
        <Button Content="1" Click="Numpad_Click" />
        <Button Content="2" Click="Numpad_Click" />
        <Button Content="3" Click="Numpad_Click" />
        <Button Content="C" Click="Numpad_Click" />
        <Button Content="0" Click="Numpad_Click" />
        <Button Content="." Click="Numpad_Click" />
      </UniformGrid>
      <StackPanel Grid.Column="1">
        <TextBlock Text="Monto recibido" Foreground="{StaticResource OnSurfaceVariant}" />
        <TextBox x:Name="PaidBox" Height="46" Margin="0,6,0,14" Padding="8" IsReadOnly="True" Background="{StaticResource SurfaceHigh}" Foreground="{StaticResource OnSurface}" BorderThickness="0" />
        <TextBlock Text="Vuelto" Foreground="{StaticResource OnSurfaceVariant}" />
        <TextBlock x:Name="ChangeText" Text="$0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Tertiary}" Margin="0,6,0,0" />
      </StackPanel>
    </Grid>
    <StackPanel Grid.Row="4" Margin="0,18,0,0">
      <Button x:Name="FinishButton" Content="Finalizar pago" Style="{StaticResource PrimaryButton}" Height="52" Click="Finish_Click" />
      <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0" Click="Cancel_Click" />
    </StackPanel>
  </Grid>
</Window>
