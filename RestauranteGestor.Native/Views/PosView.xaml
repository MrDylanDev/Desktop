<UserControl x:Class="RestauranteGestor.Native.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Surface}">
  <Grid Margin="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="320" />
      <ColumnDefinition Width="8" />
      <ColumnDefinition Width="400" MinWidth="320" MaxWidth="440" />
    </Grid.ColumnDefinitions>

    <Grid Grid.Column="0" Margin="0,0,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid Grid.Row="0">
        <TextBox x:Name="SearchBox" Height="42" Padding="12,8" Background="{StaticResource SurfaceHigh}" Foreground="{StaticResource OnSurface}" BorderThickness="0" TextChanged="SearchBox_TextChanged" />
        <TextBlock Text="Buscar plato o producto..." Foreground="{StaticResource OnSurfaceVariant}" VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False" />
      </Grid>
      <ComboBox x:Name="CategoryBox" Grid.Row="1" Height="38" Margin="0,12,0,12" Background="{StaticResource SurfaceHigh}" Foreground="{StaticResource OnSurface}" BorderThickness="0" SelectionChanged="CategoryBox_SelectionChanged" />
      <ListBox x:Name="ProductList" Grid.Row="2" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Button Width="190" Height="112" Margin="0,0,10,10" Padding="12" Style="{StaticResource SecondaryButton}" Click="Product_Click" Tag="{Binding}">
              <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="{Binding Category}" Foreground="{StaticResource Secondary}" FontSize="11" />
                <TextBlock Text="{Binding Name}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,6,0,0" />
                <TextBlock Text="{Binding PriceText}" Foreground="{StaticResource Primary}" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,10,0,0" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Border Grid.Row="3" Background="{StaticResource SurfaceContainer}" CornerRadius="10" Padding="12" Margin="0,12,0,0">
        <TextBlock Text="Atajos: F1 POS · ESC Cerrar cobro" Foreground="{StaticResource OnSurfaceVariant}" />
      </Border>
    </Grid>

    <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE" />
    <Border Grid.Column="2" Background="{StaticResource SurfaceLowest}" CornerRadius="14" Padding="16">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
          <TextBlock Text="Pedido actual" FontSize="22" FontWeight="Bold" />
          <TextBlock x:Name="MesaLabel" Text="Mesa no seleccionada" Foreground="{StaticResource Secondary}" Margin="0,6,0,6" />
          <StackPanel x:Name="DomicilioPanel" Visibility="Collapsed" Margin="0,6,0,8">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,6,0">
                <TextBlock Text="Tipo" Foreground="{StaticResource OnSurfaceVariant}" FontSize="10" Margin="0,0,0,4"/>
                <ComboBox x:Name="TipoPedidoBox" Height="32" SelectionChanged="TipoPedido_Changed"/>
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Mesa / Destino" Foreground="{StaticResource OnSurfaceVariant}" FontSize="10" Margin="0,0,0,4"/>
                <TextBlock x:Name="DestinoLabel" Text="—" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="0,6,0,0"/>
              </StackPanel>
            </Grid>
            <StackPanel x:Name="DomicilioFields" Visibility="Collapsed" Margin="0,8,0,0">
              <TextBlock Text="Datos domicilio propio (solo si Delivery activo)" Foreground="{StaticResource Secondary}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBox x:Name="ClienteDomBox" Grid.Column="0" Height="32" Padding="8" Margin="0,0,6,0" />
                <TextBox x:Name="TelDomBox" Grid.Column="1" Height="32" Padding="8" />
              </Grid>
              <Grid Margin="0,6,0,0">
                <TextBox x:Name="DirDomBox" Height="32" Padding="8"/>
                <TextBlock Text="Dirección domicilio..." Foreground="{StaticResource OnSurfaceVariant}" Opacity="0.45" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=DirDomBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>
              <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBox x:Name="ClienteDomBoxPlaceholder" Visibility="Collapsed"/>
              </Grid>
            </StackPanel>
          </StackPanel>
          <Border Background="{StaticResource SurfaceContainer}" CornerRadius="6" Padding="6,4" Margin="0,0,0,6" Visibility="Collapsed" x:Name="DeliveryBadge">
            <TextBlock Text="◎ Delivery activo — domicilio opcional" Foreground="{StaticResource Secondary}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
          </Border>
        </StackPanel>
        <ListBox x:Name="TicketList" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Background="{StaticResource SurfaceContainer}" CornerRadius="10" Padding="10" Margin="0,0,0,8">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontWeight="Bold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Detail}" Foreground="{StaticResource OnSurfaceVariant}" FontSize="12" Margin="0,4,0,0" />
                      <TextBlock Text="{Binding Notes}" Foreground="{StaticResource Secondary}" FontSize="11" FontStyle="Italic" TextWrapping="Wrap" Margin="0,4,0,0">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Style.Triggers>
                              <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                              <Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Content="−" Width="30" Height="30" Style="{StaticResource IconButton}" Click="Minus_Click" Tag="{Binding}" />
                      <TextBlock Text="{Binding Quantity}" Width="28" TextAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource OnSurface}" FontWeight="Bold" />
                      <Button Content="+" Width="30" Height="30" Style="{StaticResource IconButton}" Click="Plus_Click" Tag="{Binding}" />
                      <Button Content="×" Width="30" Height="30" Margin="6,0,0,0" Style="{StaticResource DangerButton}" Click="Remove_Click" Tag="{Binding}" />
                      <TextBlock Text="{Binding TotalText}" Foreground="{StaticResource Primary}" FontWeight="Bold" Width="70" TextAlignment="Right" VerticalAlignment="Center" />
                    </StackPanel>
                  </Grid>
                  <Button Grid.Row="1" Content="✎ Nota" FontSize="11" Padding="6,3" Margin="0,8,0,0" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Click="Note_Click" Tag="{Binding}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Margin="0,12,0,12">
          <TextBlock Text="Impuesto configurable" Foreground="{StaticResource OnSurfaceVariant}" FontSize="11" FontWeight="Bold" />
          <ComboBox x:Name="TaxSelector" Height="34" Margin="0,6,0,12" Background="{StaticResource SurfaceHigh}" Foreground="{StaticResource OnSurface}" BorderThickness="0" SelectionChanged="TaxSelector_SelectionChanged" />
          <Grid><TextBlock Text="Subtotal" Foreground="{StaticResource OnSurfaceVariant}" /><TextBlock x:Name="SubtotalText" HorizontalAlignment="Right" /></Grid>
          <Grid Margin="0,6,0,0"><TextBlock x:Name="TaxLabel" Text="Impuesto (8%)" Foreground="{StaticResource OnSurfaceVariant}" /><TextBlock x:Name="TaxText" HorizontalAlignment="Right" /></Grid>
          <Grid Margin="0,10,0,0"><TextBlock Text="Total" Foreground="{StaticResource Primary}" FontWeight="Bold" FontSize="18" /><TextBlock x:Name="TotalText" HorizontalAlignment="Right" Foreground="{StaticResource Primary}" FontWeight="Bold" FontSize="20" /></Grid>
        </StackPanel>
        <StackPanel Grid.Row="3">
          <Button Content="COBRAR" Style="{StaticResource PrimaryButton}" Height="54" Click="Checkout_Click" />
          <Button Content="Vaciar pedido" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0" Click="Clear_Click" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
