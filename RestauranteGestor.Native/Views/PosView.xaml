<UserControl x:Class="RestauranteGestor.Native.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Surface}">
  <Grid Margin="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="420" />
    </Grid.ColumnDefinitions>

    <Grid Grid.Column="0" Margin="0,0,16,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid Grid.Row="0">
        <TextBox x:Name="SearchBox" Height="42" Padding="12,8" Background="{StaticResource SurfaceHigh}" Foreground="{StaticResource OnSurface}" BorderThickness="0" TextChanged="SearchBox_TextChanged" />
        <TextBlock Text="Buscar plato o producto..." Foreground="{StaticResource OnSurfaceVariant}" VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False" />
      </Grid>
      <ComboBox x:Name="CategoryBox" Grid.Row="1" Height="38" Margin="0,12,0,12" Background="{StaticResource SurfaceHigh}" Foreground="{StaticResource OnSurface}" BorderThickness="0" SelectionChanged="CategoryBox_SelectionChanged" />
      <ListBox x:Name="ProductList" Grid.Row="2" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Button Width="190" Height="112" Margin="0,0,10,10" Padding="12" Style="{StaticResource SecondaryButton}" Click="Product_Click" Tag="{Binding}">
              <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="{Binding Category}" Foreground="{StaticResource Secondary}" FontSize="11" />
                <TextBlock Text="{Binding Name}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,6,0,0" />
                <TextBlock Text="{Binding PriceText}" Foreground="{StaticResource Primary}" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,10,0,0" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Border Grid.Row="3" Background="{StaticResource SurfaceContainer}" CornerRadius="10" Padding="12" Margin="0,12,0,0">
        <TextBlock Text="Atajos: F1 POS · ESC Cerrar cobro" Foreground="{StaticResource OnSurfaceVariant}" />
      </Border>
    </Grid>

    <Border Grid.Column="1" Background="{StaticResource SurfaceLowest}" CornerRadius="14" Padding="16">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
          <TextBlock Text="Comanda actual" FontSize="22" FontWeight="Bold" />
          <TextBlock x:Name="MesaLabel" Text="Mesa no seleccionada" Foreground="{StaticResource Secondary}" Margin="0,6,0,14" />
        </StackPanel>
        <ListBox x:Name="TicketList" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Background="{StaticResource SurfaceContainer}" CornerRadius="10" Padding="10" Margin="0,0,0,8">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource OnSurfaceVariant}" FontSize="12" Margin="0,4,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="−" Width="30" Height="30" Click="Minus_Click" Tag="{Binding}" />
                    <TextBlock Text="{Binding Quantity}" Width="28" TextAlignment="Center" VerticalAlignment="Center" />
                    <Button Content="+" Width="30" Height="30" Click="Plus_Click" Tag="{Binding}" />
                    <Button Content="×" Width="30" Height="30" Margin="6,0,0,0" Foreground="{StaticResource Error}" Click="Remove_Click" Tag="{Binding}" />
                    <TextBlock Text="{Binding TotalText}" Foreground="{StaticResource Primary}" FontWeight="Bold" Width="70" TextAlignment="Right" VerticalAlignment="Center" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Margin="0,12,0,12">
          <Grid><TextBlock Text="Subtotal" Foreground="{StaticResource OnSurfaceVariant}" /><TextBlock x:Name="SubtotalText" HorizontalAlignment="Right" /></Grid>
          <Grid Margin="0,6,0,0"><TextBlock Text="Impuesto" Foreground="{StaticResource OnSurfaceVariant}" /><TextBlock x:Name="TaxText" HorizontalAlignment="Right" /></Grid>
          <Grid Margin="0,10,0,0"><TextBlock Text="Total" Foreground="{StaticResource Primary}" FontWeight="Bold" FontSize="18" /><TextBlock x:Name="TotalText" HorizontalAlignment="Right" Foreground="{StaticResource Primary}" FontWeight="Bold" FontSize="20" /></Grid>
        </StackPanel>
        <StackPanel Grid.Row="3">
          <Button Content="COBRAR" Style="{StaticResource PrimaryButton}" Height="54" Click="Checkout_Click" />
          <Button Content="Vaciar comanda" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0" Click="Clear_Click" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
