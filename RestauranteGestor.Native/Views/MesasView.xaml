<UserControl x:Class="RestauranteGestor.Native.Views.MesasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Surface}">
  <Grid Margin="20">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="340" />
      <ColumnDefinition Width="8" />
      <ColumnDefinition Width="360" MinWidth="300" MaxWidth="400" />
    </Grid.ColumnDefinitions>
    <Grid Grid.Column="0" Margin="0,0,0,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,16">
        <TextBlock Text="Mesas y Salón" FontSize="30" FontWeight="Bold" />
        <Button Content="+ Nueva mesa" Style="{StaticResource PrimaryButton}" Height="36" Margin="20,0,0,0" Click="NewTable_Click" />
        <ComboBox x:Name="SectorBox" Width="180" Height="36" Margin="12,0,0,0" Background="{StaticResource SurfaceHigh}" Foreground="{StaticResource OnSurface}" BorderThickness="0" SelectionChanged="SectorBox_SelectionChanged" />
      </StackPanel>
      <ListBox x:Name="TablesList" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Width="240" MinHeight="168" Margin="0,0,12,12" CornerRadius="14" Background="{StaticResource SurfaceContainer}" BorderBrush="{Binding StatusBrush}" BorderThickness="2" Padding="14">
              <StackPanel>
                <Grid><TextBlock Text="{Binding Number}" FontSize="28" FontWeight="Bold" /><TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,0,0" /></Grid>
                <TextBlock Text="{Binding Capacity}" Foreground="{StaticResource OnSurfaceVariant}" FontSize="12" Margin="0,6,0,0" />
                <TextBlock Text="{Binding Total}" Foreground="{StaticResource Secondary}" FontWeight="Bold" FontSize="13" Margin="0,6,0,0" />
                <WrapPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <Button Content="Abrir en POS" Style="{StaticResource PrimaryButton}" Height="30" Padding="10,0" FontSize="11" Margin="0,0,6,6" Click="OpenPos_Click" Tag="{Binding}" IsEnabled="{Binding CanOpen}" />
                  <Button Content="Editar" Style="{StaticResource SecondaryButton}" Height="30" Padding="10,0" FontSize="11" Margin="0,0,6,6" Click="EditTable_Click" Tag="{Binding}" />
                  <Button Content="×" Style="{StaticResource DangerButton}" Height="30" Width="30" Margin="0,0,0,6" Click="DeleteTable_Click" Tag="{Binding}" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE" />
    <Border Grid.Column="2" Background="{StaticResource SurfaceContainer}" CornerRadius="14" Padding="18">
      <StackPanel>
        <TextBlock Text="Detalle de mesa" FontSize="22" FontWeight="Bold" />
        <TextBlock x:Name="DetailName" Text="Selecciona una mesa" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Primary}" Margin="0,24,0,6" />
        <TextBlock x:Name="DetailStatus" Text="" Foreground="{StaticResource Tertiary}" FontWeight="Bold" />
        <TextBlock x:Name="DetailInfo" Text="" Foreground="{StaticResource OnSurfaceVariant}" Margin="0,8,0,24" />
        <Border Background="{StaticResource SurfaceLowest}" CornerRadius="10" Padding="14" MinHeight="100">
          <TextBlock x:Name="DetailItems" Text="Sin pedido activo." Foreground="{StaticResource OnSurfaceVariant}" TextWrapping="Wrap" />
        </Border>
        <Grid Margin="0,20,0,0"><TextBlock Text="Total consumido" Foreground="{StaticResource OnSurfaceVariant}" /><TextBlock x:Name="DetailTotal" HorizontalAlignment="Right" Foreground="{StaticResource Primary}" FontSize="20" FontWeight="Bold" /></Grid>
        <Button x:Name="OpenPosButton" Content="Abrir en POS" Style="{StaticResource PrimaryButton}" Height="52" Margin="0,24,0,0" IsEnabled="False" Click="OpenSelectedPos_Click" />
        <TextBlock Text="Los datos mostrados son locales de demostración." Foreground="{StaticResource OnSurfaceVariant}" FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
