<UserControl x:Class="RestauranteGestor.Native.Views.ModulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Surface}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28">
      <TextBlock Text="Módulos" Foreground="{StaticResource Secondary}" FontWeight="Bold" FontSize="12" />
      <TextBlock Text="Escalabilidad" FontSize="36" FontWeight="Bold" Margin="0,6,0,8" />
      <TextBlock Text="Activa solo lo que tu restaurante necesita hoy. Los módulos no disponibles se muestran como próximos pasos." Foreground="{StaticResource OnSurfaceVariant}" TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left" />

      <WrapPanel Margin="0,28,0,0" Orientation="Horizontal">
        <Border Style="{StaticResource Card}" Width="360" MinWidth="280" Margin="0,0,12,12">
          <StackPanel>
            <TextBlock Text="▣" Foreground="{StaticResource Primary}" FontSize="30" />
            <TextBlock Text="Punto de Venta Esencial (POS)" FontSize="20" FontWeight="Bold" Margin="0,14,0,8" TextWrapping="Wrap" />
            <TextBlock Text="Cobro, pedido, efectivo y tarjeta como método de registro." Foreground="{StaticResource OnSurfaceVariant}" TextWrapping="Wrap" />
            <TextBlock Text="Núcleo del sistema · Activo" Foreground="{StaticResource Tertiary}" FontWeight="Bold" Margin="0,16,0,0" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Width="360" MinWidth="280" Margin="0,0,12,12">
          <StackPanel>
            <TextBlock Text="▦" Foreground="{StaticResource Secondary}" FontSize="30" />
            <TextBlock Text="Gestión de Salón y Mesas" FontSize="20" FontWeight="Bold" Margin="0,14,0,8" TextWrapping="Wrap" />
            <TextBlock Text="Plano visual, estados de mesa y apertura de pedidos." Foreground="{StaticResource OnSurfaceVariant}" TextWrapping="Wrap" />
            <CheckBox x:Name="SalonToggle" Content="Módulo activado" IsChecked="True" Foreground="{StaticResource Tertiary}" FontWeight="Bold" Margin="0,16,0,0" Checked="ModuleToggle_Changed" Unchecked="ModuleToggle_Changed" />
            <TextBlock x:Name="SalonStatus" Text="Módulo activo" Foreground="{StaticResource Tertiary}" FontWeight="Bold" Margin="0,8,0,0" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Width="360" MinWidth="280" Margin="0,0,12,12">
          <StackPanel>
            <TextBlock Text="▤" Foreground="{StaticResource Primary}" FontSize="30" />
            <TextBlock Text="Menú y productos" FontSize="20" FontWeight="Bold" Margin="0,14,0,8" TextWrapping="Wrap" />
            <TextBlock Text="Catálogo de categorías, platos, precios y disponibilidad." Foreground="{StaticResource OnSurfaceVariant}" TextWrapping="Wrap" />
            <CheckBox x:Name="MenuToggle" Content="Módulo activado" IsChecked="True" Foreground="{StaticResource Tertiary}" FontWeight="Bold" Margin="0,16,0,0" Checked="ModuleToggle_Changed" Unchecked="ModuleToggle_Changed" />
            <TextBlock x:Name="MenuStatus" Text="Módulo activo" Foreground="{StaticResource Tertiary}" FontWeight="Bold" Margin="0,8,0,0" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Width="360" MinWidth="280" Margin="0,0,12,12">
          <StackPanel>
            <TextBlock Text="♨" Foreground="{StaticResource Secondary}" FontSize="30" />
            <TextBlock Text="Cocina KDS" FontSize="20" FontWeight="Bold" Margin="0,14,0,8" TextWrapping="Wrap" />
            <TextBlock Text="Kanban de pedidos: Nuevo → En preparación → Listo (solo frontend)." Foreground="{StaticResource OnSurfaceVariant}" TextWrapping="Wrap" />
            <CheckBox x:Name="KdsToggle" Content="Módulo activado" IsChecked="False" Foreground="{StaticResource Tertiary}" FontWeight="Bold" Margin="0,16,0,0" Checked="ModuleToggle_Changed" Unchecked="ModuleToggle_Changed" />
            <TextBlock x:Name="KdsStatus" Text="Módulo desactivado" Foreground="{StaticResource OnSurfaceVariant}" FontWeight="Bold" Margin="0,8,0,0" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Width="360" MinWidth="280" Margin="0,0,12,12">
          <StackPanel>
            <TextBlock Text="▤" Foreground="{StaticResource Primary}" FontSize="30" />
            <TextBlock Text="Inventario" FontSize="20" FontWeight="Bold" Margin="0,14,0,8" TextWrapping="Wrap" />
            <TextBlock Text="Registro de insumos, descuento automático y alertas stock bajo (solo frontend)." Foreground="{StaticResource OnSurfaceVariant}" TextWrapping="Wrap" />
            <CheckBox x:Name="InventarioToggle" Content="Módulo activado" IsChecked="False" Foreground="{StaticResource Tertiary}" FontWeight="Bold" Margin="0,16,0,0" Checked="ModuleToggle_Changed" Unchecked="ModuleToggle_Changed" />
            <TextBlock x:Name="InventarioStatus" Text="Módulo desactivado" Foreground="{StaticResource OnSurfaceVariant}" FontWeight="Bold" Margin="0,8,0,0" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Width="360" MinWidth="280" Margin="0,0,12,12">
          <StackPanel>
            <TextBlock Text="◰" Foreground="{StaticResource Secondary}" FontSize="30" />
            <TextBlock Text="Reservas" FontSize="20" FontWeight="Bold" Margin="0,14,0,8" TextWrapping="Wrap" />
            <TextBlock Text="Vista calendario/agenda y asignación de mesa (solo frontend)." Foreground="{StaticResource OnSurfaceVariant}" TextWrapping="Wrap" />
            <CheckBox x:Name="ReservasToggle" Content="Módulo activado" IsChecked="False" Foreground="{StaticResource Tertiary}" FontWeight="Bold" Margin="0,16,0,0" Checked="ModuleToggle_Changed" Unchecked="ModuleToggle_Changed" />
            <TextBlock x:Name="ReservasStatus" Text="Módulo desactivado" Foreground="{StaticResource OnSurfaceVariant}" FontWeight="Bold" Margin="0,8,0,0" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Width="360" MinWidth="280" Margin="0,0,12,12">
          <StackPanel>
            <TextBlock Text="▣" Foreground="{StaticResource Primary}" FontSize="30" />
            <TextBlock Text="Reportes + Trazabilidad" FontSize="20" FontWeight="Bold" Margin="0,14,0,8" TextWrapping="Wrap" />
            <TextBlock Text="Ventas por período e historial de cobros (qué se vendió) — solo Admin (solo frontend)." Foreground="{StaticResource OnSurfaceVariant}" TextWrapping="Wrap" />
            <CheckBox x:Name="ReportesToggle" Content="Módulo activado" IsChecked="False" Foreground="{StaticResource Tertiary}" FontWeight="Bold" Margin="0,16,0,0" Checked="ModuleToggle_Changed" Unchecked="ModuleToggle_Changed" />
            <TextBlock x:Name="ReportesStatus" Text="Módulo desactivado" Foreground="{StaticResource OnSurfaceVariant}" FontWeight="Bold" Margin="0,8,0,0" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Width="360" MinWidth="280" Margin="0,0,12,12">
          <StackPanel>
            <TextBlock Text="◎" Foreground="{StaticResource Secondary}" FontSize="30" />
            <TextBlock Text="Delivery" FontSize="20" FontWeight="Bold" Margin="0,14,0,8" TextWrapping="Wrap" />
            <TextBlock Text="Pedidos Rappi/Uber/DiDi vía agregador y sincronización de menú (solo frontend)." Foreground="{StaticResource OnSurfaceVariant}" TextWrapping="Wrap" />
            <CheckBox x:Name="DeliveryToggle" Content="Módulo activado" IsChecked="False" Foreground="{StaticResource Tertiary}" FontWeight="Bold" Margin="0,16,0,0" Checked="ModuleToggle_Changed" Unchecked="ModuleToggle_Changed" />
            <TextBlock x:Name="DeliveryStatus" Text="Módulo desactivado" Foreground="{StaticResource OnSurfaceVariant}" FontWeight="Bold" Margin="0,8,0,0" />
          </StackPanel>
        </Border>
      </WrapPanel>

      <TextBlock Text="Módulos futuros" Foreground="{StaticResource Secondary}" FontWeight="Bold" Margin="0,18,0,12" />
      <WrapPanel Orientation="Horizontal">
        <Border Style="{StaticResource Card}" Width="340" MinWidth="260" Opacity="0.55" Margin="0,0,12,12"><TextBlock Text="DIAN · Próximamente" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" /></Border>
      </WrapPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
